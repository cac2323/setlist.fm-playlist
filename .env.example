SETLISTFM_API_KEY=

# Apple Music — either a pre-minted developer token...
APPLE_MUSIC_DEVELOPER_TOKEN=
# ...or mint one from your MusicKit key:
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
# Optional alternative to PRIVATE_KEY_PATH (inline PEM or path string):
# APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
APPLE_MUSIC_USE_MOCKS=false

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local: Spotify rejects "localhost"; use the loopback IP and register this exact URI.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/auth/callback
# Production example (must match Spotify Dashboard + your HTTPS host):
# SPOTIFY_REDIRECT_URI=https://your-domain.example/api/spotify/auth/callback
# Used only for client-credentials catalog search (no signed-in user).
SPOTIFY_MARKET=US
SPOTIFY_USE_MOCKS=false
